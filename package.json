    "patch-package": "^8.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "postinstall-postinstall": "^2.1.0",
    "source-map": "^0.7.6",
    "vitest": "^4.1.11"
  }
}
